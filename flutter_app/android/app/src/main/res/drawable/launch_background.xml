<?xml version="1.0" encoding="utf-8"?>
<!-- Native pre-Flutter-frame splash: white background + centered shield
     mark, matching the RN app's AppSplashScreen (components/AppSplashScreen.tsx)
     so there's no blank flash before splash_screen.dart takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
