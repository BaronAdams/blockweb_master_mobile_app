# Flutter/Dart build output — regenerated by `flutter pub get` / `flutter build`.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart

# The iOS native project is intentionally not committed yet — CI generates
# it on demand with `flutter create --platforms=ios .` (see
# .github/workflows/flutter-build.yml). It gets committed for real once a
# signed release build needs a stable Xcode project to configure.
ios/

# Android local config (SDK path etc.) — machine-specific.
android/local.properties
android/.gradle/
android/**/GeneratedPluginRegistrant.java

# IDE
.idea/
*.iml
